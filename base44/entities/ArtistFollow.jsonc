{
  "name": "ArtistFollow",
  "type": "object",
  "properties": {
    "fan_email": {
      "type": "string",
      "description": "Email of the fan following"
    },
    "artist_email": {
      "type": "string",
      "description": "Email of the artist being followed"
    },
    "artist_name": {
      "type": "string",
      "description": "Name of artist for quick lookup"
    },
    "notification_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to notify fan of artist updates"
    }
  },
  "required": [
    "fan_email",
    "artist_email"
  ]
}